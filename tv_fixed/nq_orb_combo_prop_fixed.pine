//@version=6
// Fixed copy of "NQ ORB combo (prop)" (draft 0.4 of the script now saved as "ORB15 signals (TP/SL)").
// Fixes, 2026-11-24:
//   1. The open-trades loop no longer runs when there are no open trades. Pine counts backwards when the end is
//      below the start, so "for i = 0 to strategy.opentrades - 1" ran with nothing open and could leave an exit
//      order with an old stop. (The "v4 r200" copy already had this guard.)
//   2. New input "Take 1 micro when the risk budget buys 0": with $125 risk, any stop over 31 pts on NQ
//      ($2/pt) sized to 0 contracts, which at current NQ volatility skipped almost every setup (1 trade in the
//      chart's history). On by default; a 1-micro trade then risks up to Max stop x $2 = $150. Turn it off
//      to get the original behaviour.
strategy("NQ ORB combo (prop, fixed)", overlay=true, initial_capital=50000,
     default_qty_type=strategy.fixed, calc_on_every_tick=false, pyramiding=3,
     commission_type=strategy.commission.cash_per_contract, commission_value=0.62,
     slippage=2, margin_long=0, margin_short=0)

tz        = input.string("America/New_York", "Session time zone")
riskUSD   = input.float(125.0, "Risk per setup ($)", minval=25)
ptVal     = input.float(2.0, "Point value ($/pt): MNQ=2, NQ=20")
tgtR      = input.float(3.0, "Target (R multiple)", minval=1.0)
smaLen    = input.int(50, "Daily SMA length", minval=5)
minR      = input.float(5.0, "Min stop (pts)")
maxStop   = input.float(75.0, "Max stop (pts)")
maxQty    = input.int(10, "Max contracts per setup", minval=1)
force1    = input.bool(true, "Take 1 micro when the risk budget buys 0 (up to Max stop)")
exitH     = input.int(15, "Flat hour")
exitM     = input.int(50, "Flat minute")
dllUSD    = input.float(350.0, "Daily loss limit ($): no new entries below this")
ddLockUSD = input.float(1500.0, "Stop trading if equity is this far below peak ($)")
useAlerts = input.bool(true, "Send alert() messages (webhook JSON)")
on5       = input.bool(true, "Enable ORB5")
on15      = input.bool(true, "Enable ORB15")
onDrv     = input.bool(true, "Enable Opening Drive")

hh = hour(time, tz)
mm = minute(time, tz)
mins = (hh - 9) * 60 + mm - 30
isFlatTime = hh > exitH or (hh == exitH and mm >= exitM)
live = mins >= 0 and not isFlatTime

dailyUp = request.security(syminfo.tickerid, "D", close[1] > ta.sma(close, smaLen)[1], lookahead=barmerge.lookahead_on)
dailyDn = request.security(syminfo.tickerid, "D", close[1] < ta.sma(close, smaLen)[1], lookahead=barmerge.lookahead_on)

var float dayOpen = na
var float hi5 = na
var float lo5 = na
var float hi15 = na
var float lo15 = na
var float hi6 = na
var float lo6 = na
var bool done5 = false
var bool done15 = false
var bool doneD = false
var float stop5 = na
var float stop15 = na
var float stopD = na
var float dayStartEq = na
var float eqPeak = na

if mins == 0
    dayOpen := open
    hi5 := high
    lo5 := low
    hi15 := high
    lo15 := low
    hi6 := high
    lo6 := low
    done5 := false
    done15 := false
    doneD := false
    dayStartEq := strategy.equity
if mins > 0 and mins < 15
    hi15 := math.max(hi15, high)
    lo15 := math.min(lo15, low)
if mins > 0 and mins < 30
    hi6 := math.max(hi6, high)
    lo6 := math.min(lo6, low)

eqPeak := na(eqPeak) ? strategy.equity : math.max(eqPeak, strategy.equity)
locked = strategy.equity < eqPeak - ddLockUSD or (not na(dayStartEq) and (strategy.equity - dayStartEq) <= -dllUSD)

qtyFor(float r) =>
    q = math.floor(riskUSD / (math.max(r, minR) * ptVal))
    math.min(maxQty, force1 ? math.max(q, 1) : q)

if live and not locked and on5 and not done5 and mins >= 5
    d5 = close > hi5 ? 1 : close < lo5 ? -1 : 0
    if d5 != 0
        done5 := true
        r5 = d5 == 1 ? close - lo5 : hi5 - close
        if ((d5 == 1 and dailyUp) or (d5 == -1 and dailyDn)) and r5 >= minR and r5 <= maxStop and qtyFor(r5) >= 1
            stop5 := d5 == 1 ? lo5 : hi5
            strategy.entry("ORB5", d5 == 1 ? strategy.long : strategy.short, qty=qtyFor(r5))
            if useAlerts
                alert('{"setup":"ORB5","action":"' + (d5 == 1 ? 'buy' : 'sell') + '","ticker":"' + syminfo.ticker + '","qty":' + str.tostring(qtyFor(r5)) + ',"stop":' + str.tostring(stop5) + '}', alert.freq_once_per_bar_close)

if live and not locked and on15 and not done15 and mins >= 15
    d15 = close > hi15 ? 1 : close < lo15 ? -1 : 0
    if d15 != 0
        done15 := true
        r15 = d15 == 1 ? close - lo15 : hi15 - close
        if ((d15 == 1 and dailyUp) or (d15 == -1 and dailyDn)) and r15 >= minR and r15 <= maxStop and qtyFor(r15) >= 1
            stop15 := d15 == 1 ? lo15 : hi15
            strategy.entry("ORB15", d15 == 1 ? strategy.long : strategy.short, qty=qtyFor(r15))
            if useAlerts
                alert('{"setup":"ORB15","action":"' + (d15 == 1 ? 'buy' : 'sell') + '","ticker":"' + syminfo.ticker + '","qty":' + str.tostring(qtyFor(r15)) + ',"stop":' + str.tostring(stop15) + '}', alert.freq_once_per_bar_close)

if live and not locked and onDrv and not doneD and mins == 25
    doneD := true
    mv = close - dayOpen
    rng = hi6 - lo6
    dD = mv > 0 ? 1 : -1
    if math.abs(mv) >= 0.35 * rng and math.abs(mv) >= 15 and ((dD == 1 and dailyUp) or (dD == -1 and dailyDn))
        rD = dD == 1 ? close - lo6 : hi6 - close
        if rD >= minR and rD <= maxStop and qtyFor(rD) >= 1
            stopD := dD == 1 ? lo6 : hi6
            strategy.entry("DRV", dD == 1 ? strategy.long : strategy.short, qty=qtyFor(rD))
            if useAlerts
                alert('{"setup":"DRV","action":"' + (dD == 1 ? 'buy' : 'sell') + '","ticker":"' + syminfo.ticker + '","qty":' + str.tostring(qtyFor(rD)) + ',"stop":' + str.tostring(stopD) + '}', alert.freq_once_per_bar_close)

nOpen = strategy.opentrades
if nOpen > 0
    for i = 0 to nOpen - 1
        id = strategy.opentrades.entry_id(i)
        ep = strategy.opentrades.entry_price(i)
        sz = strategy.opentrades.size(i)
        stp = id == "ORB5" ? stop5 : id == "ORB15" ? stop15 : stopD
        R = math.abs(ep - stp)
        strategy.exit("x" + id, id, stop=stp, limit=sz > 0 ? ep + tgtR * R : ep - tgtR * R)

if isFlatTime and strategy.position_size != 0
    strategy.close_all(comment="EOD flat")
    if useAlerts
        alert('{"action":"flatten","ticker":"' + syminfo.ticker + '"}', alert.freq_once_per_bar_close)

plot(live and mins < 390 ? hi5 : na, "OR5 high", color=color.teal, style=plot.style_linebr)
plot(live and mins < 390 ? lo5 : na, "OR5 low", color=color.red, style=plot.style_linebr)
bgcolor(locked ? color.new(color.red, 85) : na)
