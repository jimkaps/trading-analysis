//@version=6
// Fixed copy of "BTC 4H Donchian Trend v7 (walk-forward tested)" (draft 0.7 of the script now saved as "BTC 4h SFP+VOL").
// BTC/USDT 4H long-only Donchian trend strategy.
// Mirrors the Python walk-forward test: enter at the next open after a close above the prior N-bar high
// (and above an EMA filter); exit on an ATR chandelier trail that only ratchets up.
// Fixes, 2026-11-24:
//   1. Position size now uses syminfo.pointvalue, so the 1% risk is right on futures (MNQ = $2/pt) as well as crypto.
//   2. On futures the size is rounded down to whole contracts. The original asked for e.g. 0.37 contracts,
//      which TradingView rounds to 0, so it never traded on MNQ. Signals too small to size are counted in the table.
//   3. The table warns when the chart is not on 4-hour bars, the timeframe it was tested on.
strategy("BTC 4H Donchian Trend v7 (fixed)",
     overlay = true,
     initial_capital = 10000,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 100,
     commission_type = strategy.commission.percent,
     commission_value = 0.1,
     slippage = 0,
     pyramiding = 0,
     calc_on_every_tick = false)

// ───────────── Inputs ─────────────
brkLen  = input.int(20,   "Breakout lookback (bars)", minval = 2)
emaLen  = input.int(100,  "Trend EMA length", minval = 10)
atrLen  = input.int(14,   "ATR length", minval = 1)
atrMult = input.float(3.5, "Trail distance (x ATR)", minval = 1.0, step = 0.25)
riskPct = input.float(1.0, "Risk per trade (% of equity)", minval = 0.1, maxval = 10, step = 0.1)

// ───────────── Indicators ─────────────
upper    = ta.highest(high, brkLen)[1]   // prior N-bar high, no look-ahead
ema      = ta.ema(close, emaLen)
atr      = ta.atr(atrLen)
stopDist = atrMult * atr

// ───────────── Entry (evaluated on the bar close, fills at the next open) ─────────────
flat    = strategy.position_size == 0
longSig = flat and not na(upper) and not na(atr) and close > upper and close > ema

var float initDist  = na
var float bestPrice = na
var float trail     = na
var int   skipped   = 0

isFut = syminfo.type == "futures"
pv    = syminfo.pointvalue

if longSig
    riskQty = strategy.equity * riskPct / 100 / (stopDist * pv)
    capQty  = strategy.equity / (close * pv)                       // capped at 1x equity
    qty     = math.min(riskQty, capQty)
    qty    := isFut ? math.floor(qty) : qty
    if qty > 0
        initDist := stopDist
        strategy.entry("Long", strategy.long, qty = qty)
        strategy.exit("Exit", "Long", loss = stopDist / syminfo.mintick)  // initial stop, active from the fill
    else
        skipped += 1

// ───────────── Exit: ratcheting ATR chandelier trail ─────────────
if strategy.position_size > 0
    bestPrice := na(bestPrice) ? high : math.max(bestPrice, high)
    base      = na(trail) ? strategy.position_avg_price - initDist : trail
    trail     := math.max(base, bestPrice - stopDist)
    strategy.exit("Exit", "Long", stop = trail)
else
    bestPrice := na
    trail     := na

// ───────────── Plots ─────────────
plot(ema,   "Trend EMA",     color = color.new(color.orange, 0), linewidth = 2)
plot(upper, "Entry channel", color = color.new(color.green, 50))
plot(strategy.position_size > 0 ? trail : na, "Trail stop", color = color.new(color.fuchsia, 0), style = plot.style_linebr)
bgcolor(strategy.position_size > 0 ? color.new(color.green, 92) : na)

// ───────────── Info table ─────────────
var table info = table.new(position.top_right, 2, 4, bgcolor = color.new(color.black, 70), border_width = 1)
if barstate.islast
    totalTrades = strategy.closedtrades + strategy.opentrades
    firstTime   = strategy.closedtrades > 0 ? strategy.closedtrades.entry_time(0) : time
    weeks       = math.max((time - firstTime) / (7 * 24 * 60 * 60 * 1000), 1)
    table.cell(info, 0, 0, "Total trades",  text_color = color.white, text_size = size.small)
    table.cell(info, 1, 0, str.tostring(totalTrades), text_color = color.white, text_size = size.small)
    table.cell(info, 0, 1, "Trades / week", text_color = color.white, text_size = size.small)
    table.cell(info, 1, 1, str.tostring(totalTrades / weeks, "#.##"), text_color = color.white, text_size = size.small)
    table.cell(info, 0, 2, "Signals too small to size", text_color = color.white, text_size = size.small)
    table.cell(info, 1, 2, str.tostring(skipped), text_color = color.white, text_size = size.small)
    if timeframe.period != "240"
        table.cell(info, 0, 3, "Tested on 4h bars", text_color = color.yellow, text_size = size.small)
        table.cell(info, 1, 3, "chart is " + timeframe.period, text_color = color.yellow, text_size = size.small)
