//@version=6
// IBS long (partner TEST) - NQ/MNQ 5-minute chart, New York time. Partner for ORB15 2R (2026-11-09).
//  Signal : yesterday's CME daily bar closed in the bottom part of its range: IBS = (close - low) / (high - low) < 0.2.
//  Entry  : market at the start of the new CME session (first bar after 18:00 ET).
//  Stop   : 0.75 x daily ATR14 (simple average of true range, known at yesterday's close) below the fill.
//  Exit   : flat at 16:40 ET (prop rule: flat before 16:45) or on the session's last bar.
//  Research: ~/nq-prop-strategy/matrix/orb_partners.py. Costs = $1.25/side + 1 tick slippage (same as ORB15 2R (prop)).
//  Alerts (2026-11-24): create an alert on this strategy with "Order fills and alert() function calls" and message
//  {{strategy.order.alert_message}}. You get a message when the entry fills, when the stop is placed at the fill
//  price, and when the trade exits (stop-loss or end-of-day flat).
strategy("IBS long (partner TEST)", overlay=true, initial_capital=50000, pyramiding=0, default_qty_type=strategy.fixed, default_qty_value=1, calc_on_every_tick=false, process_orders_on_close=false, commission_type=strategy.commission.cash_per_contract, commission_value=1.25, slippage=1, margin_long=0, margin_short=0)

ibsMax  = input.float(0.2, "Buy when yesterday's IBS is below", step=0.05)
stopAtr = input.float(0.75, "Stop (x daily ATR14)", step=0.05)
exitH   = input.int(16, "Exit hour (ET)")
exitM   = input.int(40, "Exit minute (ET)")

tz = "America/New_York"
hh = hour(time, tz)
mm = minute(time, tz)

[ibsY, atrY] = request.security(syminfo.tickerid, "D", [((close - low) / (high - low))[1], ta.sma(ta.tr(true), 14)[1]], lookahead=barmerge.lookahead_on)

px(v) => str.tostring(v, format.mintick)
tag = "IBS long | " + syminfo.ticker + " | "

var float rk = na
var float stopLvl = na
var bool justEntered = false

// re-anchor the stop on the actual fill
if strategy.position_size > 0 and justEntered
    stopLvl := strategy.position_avg_price - rk
    strategy.exit("x", "L", stop=stopLvl, alert_message=tag + "LONG EXIT: stop-loss " + px(stopLvl))
    justEntered := false
    alert(tag + "stop placed at " + px(stopLvl) + " (filled " + px(strategy.position_avg_price) + ", risk " + str.tostring(rk, "#.##") + " pts)", alert.freq_once_per_bar_close)

if session.isfirstbar and strategy.position_size == 0 and not na(ibsY) and not na(atrY) and ibsY < ibsMax
    rk := stopAtr * atrY
    stopLvl := close - rk
    justEntered := true
    strategy.entry("L", strategy.long, comment="r" + str.tostring(rk, "#.##"),
         alert_message=tag + "LONG ENTRY filled at market (yesterday's IBS " + str.tostring(ibsY, "#.##") + ") | stop " + str.tostring(rk, "#.##") + " pts below the fill")
    strategy.exit("x", "L", stop=stopLvl, alert_message=tag + "LONG EXIT: stop-loss " + px(stopLvl))

lateDay = (hh == exitH and mm >= exitM) or (hh > exitH and hh < 18)
if strategy.position_size > 0 and (lateDay or session.islastbar)
    strategy.close_all(comment="EOD flat", immediately=true, alert_message=tag + "LONG EXIT: end-of-day flat")

plot(strategy.position_size > 0 ? stopLvl : na, "Stop", color.new(color.red, 0), style=plot.style_linebr)
